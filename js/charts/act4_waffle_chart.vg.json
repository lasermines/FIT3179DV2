{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 460,
  "height": 460,
  "data": {
    "url": "data/preventive_care_adoption_waffle.csv"
  },
  "transform": [
    {
      "calculate": "datum.habit === 'Vaccinated Regularly' ? 32 : datum.habit === 'Desexed' ? 26 : datum.habit === 'Microchipped' ? 18 : datum.habit === 'Insured' ? 11 : datum.habit === 'Regular Dental Care' ? 8 : 5",
      "as": "percentage"
    },
    {
      "calculate": "datum.percentage + '% of Australian Pets'",
      "as": "percentage_label"
    },
    {
      "calculate": "datum.habit === 'Vaccinated Regularly' ? 'Vaccinated Regularly (32%)' : datum.habit === 'Desexed' ? 'Desexed / Neutered (26%)' : datum.habit === 'Microchipped' ? 'Microchipped (18%)' : datum.habit === 'Insured' ? 'Pet Health Insured (11%)' : datum.habit === 'Regular Dental Care' ? 'Regular Dental Care (8%)' : 'None / Irregular Care (5%)'",
      "as": "habit_display"
    },
    {
      "calculate": "datum.habit === 'Vaccinated Regularly' ? 'Prevents fatal viral infections (parvovirus, distemper, feline enteritis); +1.5-2.5 yrs median survival' : datum.habit === 'Desexed' ? 'Eliminates reproductive cancers (pyometra, testicular/mammary tumors); +1.8-2.0 yrs median lifespan' : datum.habit === 'Microchipped' ? 'Enables reunion of lost companion animals with 2.5x higher return rate; eliminates premature euthanasia' : datum.habit === 'Insured' ? 'Removes financial barriers for emergency surgical interventions and critical intensive care' : datum.habit === 'Regular Dental Care' ? 'Prevents periodontal bacteremia, endocarditis, and chronic renal micro-vascular damage' : 'No proactive veterinary safeguards; 3.2x higher rate of preventable acute mortality'",
      "as": "protective_impact"
    }
  ],
  "params": [
    {
      "name": "habit_hover",
      "select": {
        "type": "point",
        "fields": [
          "habit_display"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 0,
    "cursor": "pointer"
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "habit_display",
      "type": "nominal",
      "scale": {
        "domain": [
          "Vaccinated Regularly (32%)",
          "Desexed / Neutered (26%)",
          "Microchipped (18%)",
          "Pet Health Insured (11%)",
          "Regular Dental Care (8%)",
          "None / Irregular Care (5%)"
        ],
        "range": [
          "#2563eb",
          "#8b5cf6",
          "#10b981",
          "#f59e0b",
          "#06b6d4",
          "#94a3b8"
        ]
      },
      "legend": {
        "title": "Preventive Care Habit",
        "titleFontSize": 12,
        "titleFontWeight": 600,
        "labelFontSize": 11,
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,
        "symbolType": "square",
        "symbolSize": 130,
        "symbolStrokeWidth": 0,
        "rowPadding": 8,
        "columnPadding": 16
      }
    },
    "opacity": {
      "condition": {
        "param": "habit_hover",
        "value": 1
      },
      "value": 0.35
    },
    "stroke": {
      "condition": {
        "param": "habit_hover",
        "empty": false,
        "value": "#f2e8dc"
      },
      "value": "#171311"
    },
    "strokeWidth": {
      "condition": {
        "param": "habit_hover",
        "empty": false,
        "value": 3.5
      },
      "value": 2
    },
    "tooltip": [
      {
        "field": "habit",
        "type": "nominal",
        "title": "Preventive Habit"
      },
      {
        "field": "percentage_label",
        "type": "nominal",
        "title": "Australian Adoption"
      },
      {
        "field": "protective_impact",
        "type": "nominal",
        "title": "Clinical & Longevity Impact"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "font": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
    "axis": {
      "domainColor": "#362f2c",
      "gridColor": "rgba(230, 213, 194, 0.06)",
      "tickColor": "#362f2c",
      "labelColor": "#96887a",
      "titleColor": "#e6d5c2",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#96887a",
      "titleColor": "#e6d5c2",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "color": "#f2e8dc",
      "subtitleColor": "#96887a",
      "fontSize": 16,
      "fontWeight": 700,
      "subtitleFontSize": 12,
      "anchor": "start",
      "offset": 12
    }
  }
}
