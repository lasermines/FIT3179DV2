{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 750,
  "height": 480,
  "projection": {
    "type": "equirectangular",
    "center": [
      133.5,
      -27.5
    ],
    "scale": 640
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states_named.topojson",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#201b19",
        "stroke": "#362f2c",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/australia_state_pet_welfare_summary_2024_2025.csv"
      },
      "params": [
        {
          "name": "capital_hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#171311"
      },
      "encoding": {
        "longitude": {
          "field": "cap_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cap_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "total_pets_received",
          "type": "quantitative",
          "title": "Total Intake (Pets)",
          "scale": {
            "type": "sqrt",
            "range": [
              180,
              1800
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              2000,
              7000,
              14000
            ],
            "titleFontSize": 11,
            "labelFontSize": 10,
            "padding": 12
          }
        },
        "color": {
          "field": "rehome_rate_pct",
          "type": "quantitative",
          "title": "Rehome Rate (%)",
          "scale": {
            "scheme": "tealblues",
            "domain": [
              50,
              70
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 11,
            "labelFontSize": 10,
            "padding": 12
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "capital_hover",
            "empty": false,
            "value": 2.5
          },
          "value": 1.2
        },
        "tooltip": [
          {
            "field": "capital",
            "type": "nominal",
            "title": "Capital Hub"
          },
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "total_pets_received",
            "type": "quantitative",
            "format": ",",
            "title": "Total Pets Received"
          },
          {
            "field": "dogs_received",
            "type": "quantitative",
            "format": ",",
            "title": "Dogs Received"
          },
          {
            "field": "cats_received",
            "type": "quantitative",
            "format": ",",
            "title": "Cats Received"
          },
          {
            "field": "rehome_rate_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Rehoming Rate (%)"
          },
          {
            "field": "euthanasia_rate_pct",
            "type": "quantitative",
            "format": ".1f",
            "title": "Euthanasia Rate (%)"
          },
          {
            "field": "intake_per_10k_pop",
            "type": "quantitative",
            "format": ".1f",
            "title": "Intake per 10k Residents"
          },
          {
            "field": "dog_to_cat_intake_ratio",
            "type": "quantitative",
            "format": ".2f",
            "title": "Dog-to-Cat Intake Ratio"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia_state_pet_welfare_summary_2024_2025.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#e2e8f0",
        "dx": {
          "expr": "datum.capital === 'Sydney' ? 22 : datum.capital === 'Canberra' ? -22 : datum.capital === 'Melbourne' ? -24 : datum.capital === 'Brisbane' ? 24 : datum.capital === 'Perth' ? -22 : datum.capital === 'Adelaide' ? -24 : datum.capital === 'Hobart' ? 20 : 0"
        },
        "dy": {
          "expr": "datum.capital === 'Sydney' ? -6 : datum.capital === 'Canberra' ? 12 : datum.capital === 'Melbourne' ? 16 : datum.capital === 'Brisbane' ? -20 : datum.capital === 'Darwin' ? -22 : datum.capital === 'Adelaide' ? 12 : 2"
        },
        "align": {
          "expr": "datum.capital === 'Sydney' || datum.capital === 'Brisbane' || datum.capital === 'Hobart' ? 'left' : datum.capital === 'Darwin' ? 'center' : 'right'"
        }
      },
      "encoding": {
        "longitude": {
          "field": "cap_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cap_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "capital",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "font": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
    "axis": {
      "domainColor": "#362f2c",
      "gridColor": "rgba(230, 213, 194, 0.06)",
      "tickColor": "#362f2c",
      "labelColor": "#baa99b",
      "titleColor": "#f5ece1",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#baa99b",
      "titleColor": "#f5ece1",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "color": "#fcf8f3",
      "subtitleColor": "#baa99b",
      "fontSize": 16,
      "fontWeight": 700,
      "subtitleFontSize": 12,
      "anchor": "start",
      "offset": 12
    }
  }
}
