{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 680,
  "height": 400,
  "data": {
    "url": "data/cat_lifestyle_hazards_pyramid.csv"
  },
  "transform": [
    {
      "calculate": "datum.lifestyle === 'Outdoor' ? -datum.percentage : datum.percentage",
      "as": "signed_percentage"
    },
    {
      "calculate": "abs(datum.percentage) + '%'",
      "as": "percentage_label"
    },
    {
      "calculate": "datum.median_lifespan_years + ' yrs'",
      "as": "lifespan_label"
    },
    {
      "calculate": "datum.lifestyle === 'Outdoor' ? 'Outdoor Cohort (Overall Median Lifespan: 4.5 yrs)' : 'Indoor Cohort (Overall Median Lifespan: 14.5 yrs)'",
      "as": "cohort_summary"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "bar_hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadius": 0,
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "cause_of_mortality",
          "type": "nominal",
          "sort": [
            "Traffic Trauma / Vehicle",
            "Infectious Disease (FIV/FeLV)",
            "Fight/Animal Attack",
            "Toxins/Poisoning",
            "Renal/Organ Failure",
            "Neoplasia/Cancer",
            "Old Age/Natural"
          ],
          "axis": {
            "title": null,
            "labelFontWeight": 600,
            "labelColor": "#e2e8f0",
            "labelFontSize": 11,
            "domain": false,
            "ticks": false,
            "offset": 8
          }
        },
        "x": {
          "field": "signed_percentage",
          "type": "quantitative",
          "scale": {
            "domain": [
              -42,
              48
            ]
          },
          "axis": {
            "title": "Mortality Proportion (% of Cohort Deaths)",
            "titleColor": "#e6d5c2",
            "titleFontSize": 12,
            "titleFontWeight": 600,
            "titlePadding": 10,
            "labelExpr": "abs(datum.value) + '%'",
            "tickCount": 9,
            "grid": true,
            "gridColor": "rgba(230, 213, 194, 0.06)"
          }
        },
        "color": {
          "field": "lifestyle",
          "type": "nominal",
          "scale": {
            "domain": [
              "Outdoor",
              "Indoor"
            ],
            "range": [
              "#ea9875",
              "#5c9cb8"
            ]
          },
          "legend": {
            "title": "Cat Lifestyle Cohort",
            "titleFontSize": 12,
            "titleFontWeight": 600,
            "labelFontSize": 12,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 110,
            "padding": 10
          }
        },
        "opacity": {
          "condition": {
            "param": "bar_hover",
            "empty": false,
            "value": 1
          },
          "value": 0.88
        },
        "stroke": {
          "condition": {
            "param": "bar_hover",
            "empty": false,
            "value": "#f2e8dc"
          },
          "value": "transparent"
        },
        "strokeWidth": {
          "value": 2
        },
        "tooltip": [
          {
            "field": "cause_of_mortality",
            "type": "nominal",
            "title": "Cause of Mortality"
          },
          {
            "field": "lifestyle",
            "type": "nominal",
            "title": "Lifestyle Cohort"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "format": ".1f",
            "title": "% Mortality Share"
          },
          {
            "field": "median_lifespan_years",
            "type": "quantitative",
            "format": ".1f",
            "title": "Median Lifespan (Years)"
          },
          {
            "field": "cohort_summary",
            "type": "nominal",
            "title": "Cohort Benchmark"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "zero": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#362f2c",
        "strokeWidth": 1.5,
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "zero",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.lifestyle === 'Outdoor'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "right",
        "dx": -6,
        "color": "#fb923c"
      },
      "encoding": {
        "y": {
          "field": "cause_of_mortality",
          "type": "nominal",
          "sort": [
            "Traffic Trauma / Vehicle",
            "Infectious Disease (FIV/FeLV)",
            "Fight/Animal Attack",
            "Toxins/Poisoning",
            "Renal/Organ Failure",
            "Neoplasia/Cancer",
            "Old Age/Natural"
          ]
        },
        "x": {
          "field": "signed_percentage",
          "type": "quantitative"
        },
        "text": {
          "field": "percentage_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.lifestyle === 'Indoor'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "left",
        "dx": 6,
        "color": "#2dd4bf"
      },
      "encoding": {
        "y": {
          "field": "cause_of_mortality",
          "type": "nominal",
          "sort": [
            "Traffic Trauma / Vehicle",
            "Infectious Disease (FIV/FeLV)",
            "Fight/Animal Attack",
            "Toxins/Poisoning",
            "Renal/Organ Failure",
            "Neoplasia/Cancer",
            "Old Age/Natural"
          ]
        },
        "x": {
          "field": "signed_percentage",
          "type": "quantitative"
        },
        "text": {
          "field": "percentage_label"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "font": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
    "axis": {
      "domainColor": "#362f2c",
      "gridColor": "rgba(230, 213, 194, 0.06)",
      "tickColor": "#362f2c",
      "labelColor": "#96887a",
      "titleColor": "#e6d5c2",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#96887a",
      "titleColor": "#e6d5c2",
      "labelFontSize": 10,
      "titleFontSize": 11
    },
    "title": {
      "color": "#f2e8dc",
      "subtitleColor": "#96887a",
      "fontSize": 16,
      "fontWeight": 700,
      "subtitleFontSize": 12,
      "anchor": "start",
      "offset": 12
    }
  }
}
